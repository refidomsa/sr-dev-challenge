# Valores por defecto para desarrollo local. El backend funciona sin este archivo:
# si una variable no existe, usa estos mismos valores.
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=fuel_orders
JWT_SECRET=local-development-secret

# Usuarios de prueba que crea el seed (solo se aplican con la base de datos vacía)
SEED_PASSWORD=example
SEED_OPERATOR_EMAIL=example
SEED_DISTRIBUTOR_1_EMAIL=example
SEED_DISTRIBUTOR_2_EMAIL=example
